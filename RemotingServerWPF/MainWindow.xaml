<Window x:Class="RemotingServerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoting Server — Dashboard"
        Height="680" Width="980"
        MinHeight="500" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ══════════════════════════════════════════
         WINDOW BACKGROUND
    ══════════════════════════════════════════ -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
            <GradientStop Color="#070A16" Offset="0"/>
            <GradientStop Color="#0B1028" Offset="0.45"/>
            <GradientStop Color="#0A0D1E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <!-- ──────── COLOR TOKENS ──────── -->
        <Color x:Key="AccentBlue">#4A9FFF</Color>
        <Color x:Key="AccentCyan">#00D4FF</Color>
        <Color x:Key="AccentPurple">#8B7CF6</Color>
        <Color x:Key="SuccessGreen">#10F08C</Color>
        <Color x:Key="DangerRed">#FF6B6B</Color>
        <Color x:Key="WarnAmber">#FFB74D</Color>
        <Color x:Key="Surface">#0E1525</Color>
        <Color x:Key="SurfaceHigh">#192240</Color>
        <Color x:Key="Border">#1C2D52</Color>
        <Color x:Key="TextPrimary">#EEF2FF</Color>
        <Color x:Key="TextSecondary">#7B89A8</Color>

        <!-- ──────── BRUSHES ──────── -->
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
            <GradientStop Color="{StaticResource AccentCyan}"  Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="1,0.8">
            <GradientStop Color="#0B1830" Offset="0"/>
            <GradientStop Color="#0D2848" Offset="0.5"/>
            <GradientStop Color="#091428" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource Surface}"/>
        <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHigh}"/>
        <SolidColorBrush x:Key="BorderBrush"      Color="{StaticResource Border}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>

        <!-- ──────── IMPLICIT TEXTBLOCK ──────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
        </Style>

        <!-- ──────── CARD BORDER (glassmorphism) ──────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="#121C32" Offset="0"/>
                        <GradientStop Color="#0D1525" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#223558" Offset="0"/>
                        <GradientStop Color="#141E30" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Opacity="0.28" ShadowDepth="5" Color="#000510"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── STAT LABEL ──────── -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ──────── STAT VALUE ──────── -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ──────── GLOW ICON CIRCLE ──────── -->
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width"        Value="46"/>
            <Setter Property="Height"       Value="46"/>
            <Setter Property="CornerRadius" Value="23"/>
            <Setter Property="Margin"       Value="0"/>
        </Style>

        <!-- ──────── PRIMARY BUTTON ──────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="26,13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glow layer -->
                            <Border x:Name="glowLayer"
                                    CornerRadius="12"
                                    Opacity="0"
                                    Margin="-4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#804A9FFF" Offset="0"/>
                                        <GradientStop Color="#8000D4FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <!-- Button body -->
                            <Border x:Name="btnBody"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glowLayer" Property="Opacity" Value="1"/>
                                <Setter TargetName="btnBody"   Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBody"  Property="Opacity" Value="0.78"/>
                                <Setter TargetName="glowLayer" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBody" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── SECONDARY BUTTON ──────── -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#EEF2FF"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="24,13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Background="#192240"
                                BorderBrush="#283E68"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E2E50"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3A5580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#141E38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── LINK BUTTON ──────── -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground"      Value="#4A9FFF"/>
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── DARK COMBOBOX ──────── -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="btnBorder"
                    Background="#0D182E"
                    BorderBrush="#203864"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          Data="M0,0 L4,4 L8,0"
                          Stroke="#60A5FA"
                          StrokeThickness="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4A9FFF"/>
                    <Setter TargetName="btnBorder" Property="Background" Value="#122240"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4A9FFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEF2FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#183664"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1E4480"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="#091224"
                                        BorderBrush="#203864"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" Opacity="0.6" ShadowDepth="4" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── SVG ICON GEOMETRIES ──────── -->
        <Geometry x:Key="BoltIcon">M7,2V13H10V22L17,11H13L17,2Z</Geometry>
        <Geometry x:Key="PlugIcon">M16,7V3H14V7H10V3H8V7H7C5.9,7 5,7.9 5,9V11L7,13V20A1,1 0 0,0 8,21H16A1,1 0 0,0 17,20V13L19,11V9C19,7.9 18.1,7 17,7H16Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z</Geometry>
        <Geometry x:Key="ActivityIcon">M3.5,18.49L9.5,12.5L13.5,16.5L22,6.92L20.59,5.51L13.5,13.97L9.5,9.97L2,17.47Z</Geometry>
        <Geometry x:Key="ClipboardIcon">M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V21C3,22.1 3.9,23 5,23H19C20.1,23 21,22.1 21,21V5C21,3.9 20.1,3 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H13V17H7V15Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="ServerIcon">M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H8V3H5M5,11V13H8V11H5M5,19V21H8V19H5Z</Geometry>
        <Geometry x:Key="ChatIcon">M12,3C6.5,3 2,6.58 2,11C2.05,13.15 3.06,15.17 4.8,16.6C4.46,18.5 3.7,19.9 2.5,21C4.33,21 6.5,20.17 8.09,19.1C9.33,19.68 10.66,19.99 12,20C17.5,20 22,16.42 22,12C22,7.58 17.5,3 12,3Z</Geometry>
        <Geometry x:Key="SendIcon">M2,21L23,12L2,3V10L17,12L2,14V21Z</Geometry>
        <Geometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="DownloadIcon">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</Geometry>
        <Geometry x:Key="UploadIcon">M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z</Geometry>
        <Geometry x:Key="AttachmentIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</Geometry>

        <!-- ──────── SCROLLBAR ──────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ──────── DARK CHECKBOX ──────── -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBorder" Width="16" Height="16" CornerRadius="4"
                                    Background="#0E1626" BorderBrush="#253555" BorderThickness="1.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="chkMark" Data="M3,8 L6,11 L13,4" 
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#00C853"/>
                                <Setter Property="Foreground" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#00C853"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#00C853"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── PILL TAB STYLE ──────── -->
        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#7B89A8"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="20,10"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,8,0"
                                Background="#0D1422"
                                BorderBrush="#1C2D52"
                                BorderThickness="1">
                            <ContentPresenter x:Name="tabHeader"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#141E35"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#283E68"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4A9FFF" Offset="0"/>
                                            <GradientStop Color="#00D4FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="tabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.55" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── DARK TEXTBOX ──────── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#070D1C"/>
            <Setter Property="Foreground"      Value="#EEF2FF"/>
            <Setter Property="BorderBrush"     Value="#1C2D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="#4A9FFF"/>
            <Setter Property="SelectionBrush"  Value="#4A9FFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#283E68"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A9FFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════
         ROOT GRID
    ══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header        -->
            <RowDefinition Height="Auto"/>
            <!-- Stats row     -->
            <RowDefinition Height="Auto"/>
            <!-- IP Banner     -->
            <RowDefinition Height="*"/>
            <!-- Log panel     -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar    -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════
             ROW 0 · HEADER
        ════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGrad}" Padding="32,20">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A60" Offset="0"/>
                    <GradientStop Color="#0D2040" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

            <Grid MaxWidth="1260" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo circle with enhanced glow -->
                <Border Grid.Column="0"
                        Width="50" Height="50" CornerRadius="25"
                        Margin="0,0,18,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A9FFF" Offset="0"/>
                            <GradientStop Color="#8B7CF6" Offset="0.5"/>
                            <GradientStop Color="#00D4FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" Opacity="0.65" ShadowDepth="0" Color="#4A9FFF"/>
                    </Border.Effect>
                    <Viewbox Width="26" Height="26">
                        <Path Data="{StaticResource BoltIcon}" Fill="White" Stretch="Uniform"/>
                    </Viewbox>
                </Border>

                <!-- Title block -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="Bold">
                        <Run Foreground="#EEF2FF" Text="REMOTING SERVER"/>
                        <Run Foreground="#4A9FFF" Text="  ·  "/>
                        <Run Foreground="#8B7CF6" Text="Dashboard"/>
                    </TextBlock>
                    <TextBlock Text="Giám sát &amp; điều khiển .NET Remoting TCP Server"
                               Foreground="#5A7BA8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status badge -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        CornerRadius="22" Padding="16,9">
                    <Border.Background>
                        <SolidColorBrush x:Name="StatusBadgeBg" Color="#1A0D0D"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="StatusBadgeBorder" Color="#4A1515"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="StatusDotColor" Color="#FF6B6B"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="StatusDotGlow" BlurRadius="10" Opacity="0.9" ShadowDepth="0" Color="#FF6B6B"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="Offline"
                                   FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="StatusTextColor" Color="#FF6B6B"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════
             ROW 1 · STATS CARDS + BUTTON
        ════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,0" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Card: Port -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CỔNG SERVER" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="8085" Style="{StaticResource StatValue}">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4A9FFF" Offset="0"/>
                                    <GradientStop Color="#00D4FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconCircle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A2E60" Offset="0"/>
                                <GradientStop Color="#0E1A3A" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Opacity="0.3" ShadowDepth="0" Color="#4A9FFF"/>
                        </Border.Effect>
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource PlugIcon}" Fill="#4A9FFF" Stretch="Uniform"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- Card: Uptime -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="THỜI GIAN CHẠY" Style="{StaticResource StatLabel}"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="38" HorizontalAlignment="Left">
                            <TextBlock x:Name="UptimeText" Text="00:00:00"
                                       Style="{StaticResource StatValue}" Foreground="#10F08C"/>
                        </Viewbox>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconCircle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#0F3528" Offset="0"/>
                                <GradientStop Color="#081E16" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Opacity="0.3" ShadowDepth="0" Color="#10F08C"/>
                        </Border.Effect>
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource ClockIcon}" Fill="#10F08C" Stretch="Uniform"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- Card: Requests -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SỐ REQUEST" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="RequestCountText" Text="0"
                                   Style="{StaticResource StatValue}" Foreground="#FFB74D"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconCircle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#302412" Offset="0"/>
                                <GradientStop Color="#1C1408" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Opacity="0.3" ShadowDepth="0" Color="#FFB74D"/>
                        </Border.Effect>
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource ActivityIcon}" Fill="#FFB74D" Stretch="Uniform"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- Start/Stop Button & Auto-start checkbox -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="StartStopBtn"
                        Style="{StaticResource PrimaryBtn}"
                        Content="KHỞI ĐỘNG"
                        Click="StartStopBtn_Click"
                        Padding="28,14">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C853" Offset="0"/>
                            <GradientStop Color="#10F08C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.5" ShadowDepth="0" Color="#00C853"/>
                    </Button.Effect>
                </Button>
                <CheckBox x:Name="ServerAutoStartCheckBox"
                          Style="{StaticResource DarkCheckBox}"
                          Content="Tự khởi động khi mở"
                          ToolTip="Tự động khởi động Server mỗi khi mở ứng dụng"
                          Margin="0,8,0,0" HorizontalAlignment="Center"
                          Checked="ServerAutoStartCheckBox_Changed"
                          Unchecked="ServerAutoStartCheckBox_Changed"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════
             ROW 2 · IP / CONNECTION BANNER
        ════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="24,12,24,0" MaxWidth="1260" HorizontalAlignment="Stretch" CornerRadius="14" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D1F42" Offset="0"/>
                    <GradientStop Color="#0A1830" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4A9FFF" Offset="0"/>
                    <GradientStop Color="#1C2D52" Offset="0.4"/>
                    <GradientStop Color="#1C2D52" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource ServerIcon}" Fill="#4A9FFF" Stretch="Uniform"/>
                </Viewbox>

                <!-- IP Label & Selector -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="IP MÁY SERVER (CHỌN MẠNG KẾT NỐI)" Foreground="#5A7BA8"
                               FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ServerIpComboBox"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="ServerIpComboBox_SelectionChanged"
                              MinWidth="250" Height="34"
                              Cursor="Hand">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Ip}" FontWeight="Bold" Foreground="#60A5FA"
                                               Margin="0,0,8,0" FontFamily="Cascadia Code, Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name, StringFormat='({0})'}"
                                               Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Full connection URL -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="URL KẾT NỐI CHO CLIENT" Foreground="#5A7BA8"
                               FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConnectionUrlText" Text="tcp://…:8085/CalculatorServiceURI"
                               Foreground="#8DB8E0" FontSize="13"
                               FontFamily="Cascadia Code, Consolas"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Copy button -->
                <Button Grid.Column="3" x:Name="CopyUrlBtn"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="18,10"
                        Click="CopyUrlBtn_Click"
                        VerticalAlignment="Center">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4A9FFF" Offset="0"/>
                            <GradientStop Color="#00D4FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Fill="White" Stretch="Uniform"
                                  Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                        </Viewbox>
                        <TextBlock Text="Sao chép" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════
             ROW 3 · TABS: LOG & CHAT & FILES
        ════════════════════════════════════ -->
        <TabControl Grid.Row="3" Margin="24,12,24,14" MaxWidth="1260" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">

            <!-- ── TAB 1: NHẬT KÝ HOẠT ĐỘNG ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource ClipboardIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Nhật Ký Hoạt Động" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#152A4E" CornerRadius="10" Padding="8,3"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LogCountBadge" Text="0 sự kiện"
                                       FontSize="10" Foreground="#4A9FFF" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Style="{StaticResource Card}" CornerRadius="16" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Log Header Bar -->
                        <Border Grid.Row="0" Padding="20,12" CornerRadius="16,16,0,0" Background="#131D32"
                                BorderBrush="#1C2D52" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="DỮ LIỆU LOG CHI TIẾT TỪ .NET REMOTING SERVICE"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource LinkBtn}"
                                        Click="ClearLogBtn_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource RefreshIcon}" Fill="#7B89A8" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="Xóa log" Foreground="#7B89A8" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Log TextBox -->
                        <Border Grid.Row="1" CornerRadius="0,0,16,16" Background="#070D1C">
                            <TextBox x:Name="LogTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     Foreground="#8DB8E0"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12.5"
                                     BorderThickness="0"
                                     Padding="20,14"
                                     AcceptsReturn="True"
                                     SelectionBrush="#4A9FFF"
                                     CaretBrush="#4A9FFF"/>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ── TAB 2: TRÒ CHUYỆN (CHAT) ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource ChatIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Trò Chuyện Trực Tuyến" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border x:Name="ServerChatBadge" Background="#00C853" CornerRadius="10"
                                Padding="7,2" Margin="8,0,0,0">
                            <TextBlock x:Name="ServerChatCount" Text="0 tin" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chat Header Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="KÊNH CHAT TỨC THÌ VỚI CLIENTS" Foreground="#7B89A8"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Tin nhắn từ Server sẽ phát tới toàn bộ Client"
                                       Foreground="#5A7BA8" FontSize="11" FontStyle="Italic"/>
                        </Grid>

                        <!-- Chat Message List -->
                        <Border Grid.Row="1" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Margin="0,0,0,14" Padding="14,10">
                            <ScrollViewer x:Name="ServerChatScrollViewer" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ServerChatMessagesPanel">
                                    <TextBlock x:Name="ServerChatEmptyHint"
                                               Text="Chưa có tin nhắn nào. Khi Server hoặc Client nhắn tin, nội dung sẽ xuất hiện tại đây!"
                                               Foreground="#4A6A8A" FontStyle="Italic"
                                               HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="13"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Server Chat Input & Send -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Attach File / Media Button -->
                            <Button Grid.Column="0" x:Name="ServerChatAttachBtn"
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="ServerChatAttachBtn_Click"
                                    ToolTip="Gửi ảnh, GIF, nhạc, video hoặc tệp tin vào chat từ Server"
                                    Height="44" Padding="14,0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                        <Path Data="{StaticResource AttachmentIcon}" Fill="#7B89A8" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="Đính kèm" FontSize="12" Foreground="#EEF2FF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBox Grid.Column="1" x:Name="ServerChatInputTextBox"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0" Height="44"
                                     KeyDown="ServerChatInputTextBox_KeyDown"
                                     PreviewKeyDown="ServerChatInputTextBox_PreviewKeyDown"
                                     VerticalContentAlignment="Center"
                                     Padding="14,0"/>

                            <Button Grid.Column="3" x:Name="ServerSendChatBtn"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="ServerSendChatBtn_Click"
                                    Padding="24,11" Height="44">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00C853" Offset="0"/>
                                        <GradientStop Color="#10F08C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="14" Opacity="0.4" ShadowDepth="0" Color="#00C853"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource SendIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="Gửi từ Server" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ── TAB 3: TRUYỀN TỆP TIN ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource FolderIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Truyền Tệp Tin" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border x:Name="ServerFilesBadge" Background="#4A9FFF" CornerRadius="10"
                                Padding="7,2" Margin="8,0,0,0">
                            <TextBlock x:Name="ServerFilesCount" Text="0 tệp" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card 1: Send file from Server -->
                        <Border Grid.Row="0" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Padding="20,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="GỬI TỆP TIN TỪ MÁY SERVER CHO CLIENT"
                                           Foreground="#7B89A8" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" x:Name="ChooseFileServerBtn"
                                            Style="{StaticResource SecondaryBtn}"
                                            Click="ChooseFileServerBtn_Click"
                                            Padding="18,10" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FolderIcon}" Fill="#4A9FFF" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="Chọn tệp tin..." Foreground="#EEF2FF" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="1" Background="#050A14" CornerRadius="10"
                                            BorderBrush="#1A2A48" BorderThickness="1"
                                            Padding="14,10" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ServerSelectedFileText"
                                                   Text="Chưa chọn tệp tin nào từ máy Server..."
                                                   Foreground="#5A7BA8" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <Button Grid.Column="2" x:Name="SendFileToClientBtn"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="SendFileToClientBtn_Click"
                                            IsEnabled="False"
                                            Padding="22,10">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00C853" Offset="0"/>
                                                <GradientStop Color="#10F08C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="0" Color="#00C853"/>
                                        </Button.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource UploadIcon}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="Gửi cho Client" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card 2: File list -->
                        <Border Grid.Row="2" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- File Toolbar -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="DANH SÁCH TỆP TIN TRUYỀN QUA LẠI GIỮA SERVER &amp; CLIENT" Foreground="#7B89A8"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource LinkBtn}"
                                                Click="RefreshServerFilesBtn_Click" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="↻  Làm mới" Foreground="#4A9FFF" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button x:Name="OpenStorageFolderBtn" Style="{StaticResource PrimaryBtn}"
                                                Click="OpenStorageFolderBtn_Click" Padding="16,8">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#1E3A5F" Offset="0"/>
                                                    <GradientStop Color="#2A4A7A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource FolderIcon}" Fill="White" Stretch="Uniform"/>
                                                </Viewbox>
                                                <TextBlock Text="Mở thư mục lưu trữ" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- File Items List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ServerFileListPanel">
                                        <TextBlock x:Name="ServerFilesEmptyHint"
                                                   Text="Chưa có tệp tin nào. Bạn có thể chọn tệp ở trên để gửi cho Client hoặc nhận tệp từ Client!"
                                                   Foreground="#4A6A8A" FontStyle="Italic"
                                                   HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="13"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ════════════════════════════════════
             ROW 4 · STATUS BAR
        ════════════════════════════════════ -->
        <Border Grid.Row="4" Padding="28,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#060912" Offset="0"/>
                    <GradientStop Color="#080C18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1C2D52" Offset="0"/>
                    <GradientStop Color="#111827" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
            <Grid MaxWidth="1260" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4A9FFF" Offset="0"/>
                                <GradientStop Color="#8B7CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Foreground="#3A5580" FontSize="11"
                               Text=".NET Remoting Server  ·  .NET Framework 4.7.2  ·  TCP Channel  ·  SingleCall"/>
                </StackPanel>
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right"
                           Foreground="#3A5580" FontSize="11" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas"/>
            </Grid>
        </Border>
    </Grid>
</Window>
