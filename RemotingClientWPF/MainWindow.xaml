<Window x:Class="RemotingClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoting Client"
        Height="680" Width="960"
        MinHeight="500" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ══════════════════════════════════════
         WINDOW BACKGROUND
    ══════════════════════════════════════ -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
            <GradientStop Color="#070A16" Offset="0"/>
            <GradientStop Color="#0B1028" Offset="0.45"/>
            <GradientStop Color="#0A0D1E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <!-- ──────── IMPLICIT TEXTBLOCK ──────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF2FF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
        </Style>

        <!-- ──────── CARD (glassmorphism) ──────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="#121C32" Offset="0"/>
                        <GradientStop Color="#0D1525" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#223558" Offset="0"/>
                        <GradientStop Color="#141E30" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Opacity="0.28" ShadowDepth="5" Color="#000510"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── FIELD LABEL ──────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"      Value="#7B89A8"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Margin"          Value="0,0,0,7"/>
        </Style>

        <!-- ──────── DARK TEXTBOX ──────── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#070D1C"/>
            <Setter Property="Foreground"      Value="#EEF2FF"/>
            <Setter Property="BorderBrush"     Value="#1C2D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="#4A9FFF"/>
            <Setter Property="SelectionBrush"  Value="#4A9FFF"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#283E68"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A9FFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── PRIMARY BUTTON ──────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="24,13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glowLayer" CornerRadius="12" Opacity="0" Margin="-4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#804A9FFF" Offset="0"/>
                                        <GradientStop Color="#8000D4FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                            </Border>
                            <Border x:Name="btnBody" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glowLayer" Property="Opacity" Value="1"/>
                                <Setter TargetName="btnBody"   Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBody"   Property="Opacity" Value="0.78"/>
                                <Setter TargetName="glowLayer" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBody" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── SECONDARY BUTTON ──────── -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#EEF2FF"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="24,13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Background="#192240"
                                BorderBrush="#283E68"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E2E50"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3A5580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#141E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── LINK BUTTON ──────── -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#7B89A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground"      Value="#4A9FFF"/>
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── OPERATION RADIO BUTTON ──────── -->
        <Style x:Key="OpBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEF2FF"/>
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="opBorder"
                                Width="60" Height="54" CornerRadius="14"
                                Background="#0D1422"
                                BorderBrush="#1C2D52" BorderThickness="1"
                                Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.25" ShadowDepth="2" Color="#000510"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="opBorder" Property="Background" Value="#162240"/>
                                <Setter TargetName="opBorder" Property="BorderBrush" Value="#283E68"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="opBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4A9FFF" Offset="0"/>
                                            <GradientStop Color="#8B7CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="opBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="opBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.6" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── DARK CHECKBOX ──────── -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBorder" Width="16" Height="16" CornerRadius="4"
                                    Background="#0E1626" BorderBrush="#253555" BorderThickness="1.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="chkMark" Data="M3,8 L6,11 L13,4" 
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#4A9FFF"/>
                                <Setter Property="Foreground" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#4A9FFF"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#4A9FFF"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── PILL TAB STYLE ──────── -->
        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#7B89A8"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="20,10"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,8,0"
                                Background="#0D1422"
                                BorderBrush="#1C2D52"
                                BorderThickness="1">
                            <ContentPresenter x:Name="tabHeader"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#141E35"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#283E68"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4A9FFF" Offset="0"/>
                                            <GradientStop Color="#00D4FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="tabHeader" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush"  Value="Transparent"/>
                                <Setter TargetName="tabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.55" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ──────── RESULT PANEL ──────── -->
        <Style x:Key="ResultPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0A1428" Offset="0"/>
                        <GradientStop Color="#060E1E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="BorderBrush"     Value="#1C2D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="22,18"/>
        </Style>

        <!-- ──────── SVG ICON GEOMETRIES ──────── -->
        <Geometry x:Key="MonitorIcon">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</Geometry>
        <Geometry x:Key="LinkIcon">M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7C4.24,7 2,9.24 2,12C2,14.76 4.24,17 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17C19.76,17 22,14.76 22,12C22,9.24 19.76,7 17,7Z</Geometry>
        <Geometry x:Key="SendIcon">M2.01,21L23,12L2.01,3L2,10L17,12L2,14Z</Geometry>
        <Geometry x:Key="ChatIcon">M20,2H4C2.9,2 2,2.9 2,4V22L6,18H20C21.1,18 22,17.1 22,16V4C22,2.9 21.1,2 20,2Z</Geometry>
        <Geometry x:Key="BoltIcon">M7,2V13H10V22L17,11H13L17,2Z</Geometry>
        <Geometry x:Key="CalcIcon">M17,2H7A2,2 0 0,0 5,4V20A2,2 0 0,0 7,22H17A2,2 0 0,0 19,20V4A2,2 0 0,0 17,2M7,4H17V8H7V4M7,10H9V12H7V10M11,10H13V12H11V10M15,10H17V12H15V10M7,14H9V16H7V14M11,14H13V16H11V14M15,14H17V18H15V14M7,18H13V20H7V18Z</Geometry>
        <Geometry x:Key="ClipboardIcon">M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V21C3,22.1 3.9,23 5,23H19C20.1,23 21,22.1 21,21V5C21,3.9 20.1,3 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H13V17H7V15Z</Geometry>
        <Geometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="DownloadIcon">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</Geometry>
        <Geometry x:Key="UploadIcon">M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z</Geometry>
        <Geometry x:Key="AttachmentIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</Geometry>

        <!-- ──────── SCROLLBAR ──────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════
         ROOT GRID
    ══════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header         -->
            <RowDefinition Height="Auto"/>   <!-- Connection bar -->
            <RowDefinition Height="*"/>      <!-- Tabs           -->
            <RowDefinition Height="Auto"/>   <!-- Status bar     -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════
             ROW 0 · HEADER
        ════════════════════════════════ -->
        <Border Grid.Row="0" Padding="32,22,32,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
                    <GradientStop Color="#0B1830" Offset="0"/>
                    <GradientStop Color="#0D2848" Offset="0.5"/>
                    <GradientStop Color="#091428" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A60" Offset="0"/>
                    <GradientStop Color="#0D2040" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

            <Grid MaxWidth="1260" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon circle with violet-blue gradient -->
                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25"
                        Margin="0,0,18,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0072FF" Offset="0"/>
                            <GradientStop Color="#8B7CF6" Offset="0.5"/>
                            <GradientStop Color="#00D4FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" Opacity="0.65" ShadowDepth="0" Color="#0072FF"/>
                    </Border.Effect>
                    <Viewbox Width="26" Height="26">
                        <Path Data="{StaticResource MonitorIcon}" Fill="White" Stretch="Uniform"/>
                    </Viewbox>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="Bold">
                        <Run Foreground="#EEF2FF" Text="REMOTING CLIENT"/>
                        <Run Foreground="#4A9FFF" Text="  ·  "/>
                        <Run Foreground="#8B7CF6" Text="Giao diện gọi dịch vụ"/>
                    </TextBlock>
                    <TextBlock Text="Kết nối và gọi .NET Remoting TCP từ xa"
                               Foreground="#5A7BA8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Connection status badge -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        CornerRadius="22" Padding="16,9">
                    <Border.Background>
                        <SolidColorBrush x:Name="ConnBadgeBg" Color="#1A0D0D"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="ConnBadgeBorder" Color="#4A1515"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnStatusDot" Width="10" Height="10"
                                 VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="ConnDotColor" Color="#FF6B6B"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.9" ShadowDepth="0" Color="#FF6B6B"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="ConnStatusText" Text="Chưa kết nối"
                                   FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="ConnTextColor" Color="#FF6B6B"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════
             ROW 1 · CONNECTION BAR
        ════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,14,24,0" Padding="22,16" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4A9FFF" Offset="0"/>
                    <GradientStop Color="#1C2D52" Offset="0.3"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Label -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Viewbox Width="24" Height="24">
                            <Path Data="{StaticResource LinkIcon}" Fill="#4A9FFF" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="SERVER" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#7B89A8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- URL TextBox -->
                    <TextBox x:Name="ServerUrlTextBox" Grid.Column="1"
                             Text="tcp://localhost:8085/CalculatorServiceURI"
                             ToolTip="Nhập IP Server nếu chạy khác máy (vd: tcp://192.168.1.10:8085/CalculatorServiceURI) hoặc localhost nếu cùng máy"
                             Style="{StaticResource DarkTextBox}"
                             Margin="0" VerticalAlignment="Center"
                             FontSize="13" FontFamily="Cascadia Code, Consolas"/>

                    <!-- Paste IP Button -->
                    <Button x:Name="PasteIpBtn" Grid.Column="2"
                            Style="{StaticResource SecondaryBtn}"
                            Click="PasteIpBtn_Click"
                            ToolTip="Dán địa chỉ IP hoặc toàn bộ URL từ Clipboard để thay thế nhanh"
                            Margin="10,0,0,0" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource ClipboardIcon}" Fill="#7B89A8" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock x:Name="PasteIpBtnText" Text="Dán IP" Foreground="#EEF2FF"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Connect Button -->
                    <Button x:Name="ConnectBtn" Grid.Column="3"
                            Style="{StaticResource PrimaryBtn}"
                            Content="KẾT NỐI"
                            Click="ConnectBtn_Click"
                            Margin="10,0,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4A9FFF" Offset="0"/>
                                <GradientStop Color="#00D4FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.5" ShadowDepth="0" Color="#4A9FFF"/>
                        </Button.Effect>
                    </Button>
                </Grid>

                <!-- Row 1: Settings Toolbar -->
                <Grid Grid.Row="1" Margin="42,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="AutoConnectCheckBox" Grid.Column="0"
                              Style="{StaticResource DarkCheckBox}"
                              Content="Tự động kết nối khi mở"
                              ToolTip="Tự động kết nối tới Server này khi khởi động ứng dụng"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                              Margin="0,0,22,0"/>

                    <CheckBox x:Name="RememberSettingsCheckBox" Grid.Column="1"
                              Style="{StaticResource DarkCheckBox}"
                              IsChecked="True"
                              Content="Ghi nhớ cài đặt (IP, Họ tên, Mã SV, Chat)"
                              ToolTip="Tự động lưu và điền lại IP, Họ tên, Mã SV và tên chat cho các lần sau"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                    <Button x:Name="SaveSettingsBtn" Grid.Column="3"
                            Style="{StaticResource LinkBtn}"
                            Content="Lưu cấu hình"
                            ToolTip="Lưu cấu hình hiện tại ngay lập tức"
                            Click="SaveSettingsBtn_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ════════════════════════════════
             ROW 2 · TAB CONTROL
        ════════════════════════════════ -->
        <TabControl x:Name="ClientTabControl" Grid.Row="2" Margin="24,14,24,14" MaxWidth="1260" HorizontalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0">

            <!-- ── TAB 1: Gửi Lời Chào ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource ClipboardIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Gửi Lời Chào" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="#0E1828" CornerRadius="16" Padding="32,24" Margin="0,8,0,0"
                            BorderBrush="#1C2D52" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: inputs -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THÔNG TIN SINH VIÊN" Foreground="#7B89A8"
                                           FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="HỌ TÊN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameTextBox" Style="{StaticResource DarkTextBox}"
                                         Height="44"/>

                                <TextBlock Text="MÃ SINH VIÊN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="StudentIdTextBox" Style="{StaticResource DarkTextBox}"
                                         Height="44"/>

                                <Button x:Name="SendGreetingBtn"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="SendGreetingBtn_Click"
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"
                                        Margin="0,8,0,0">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4A9FFF" Offset="0"/>
                                            <GradientStop Color="#00D4FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="14" Opacity="0.5" ShadowDepth="0" Color="#4A9FFF"/>
                                    </Button.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource SendIcon}" Fill="White" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="Gửi Lời Chào" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Margin="12,0" VerticalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1C2D52" Offset="0"/>
                                        <GradientStop Color="#0E1828" Offset="0.5"/>
                                        <GradientStop Color="#1C2D52" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Right: result -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="KẾT QUẢ PHẢN HỒI" Foreground="#7B89A8"
                                           FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,20"/>

                                <Border Style="{StaticResource ResultPanel}" MinHeight="180">
                                    <StackPanel VerticalAlignment="Center">
                                        <Viewbox Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <Path Data="{StaticResource ChatIcon}" Fill="#3A5580" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock x:Name="GreetingResultText"
                                                   Text="Kết quả sẽ hiển thị tại đây…"
                                                   Foreground="#4A6A8A"
                                                   FontSize="14" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2: Máy Tính Từ Xa ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource CalcIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Máy Tính Từ Xa" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="#0E1828" CornerRadius="16" Padding="32,24" Margin="0,8,0,0"
                            BorderBrush="#1C2D52" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Input row: A  [op]  B -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Number A -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SỐ A" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NumberATextBox"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="0" FontSize="22" TextAlignment="Center"
                                             Height="52"
                                             KeyDown="NumberTextBox_KeyDown"/>
                                </StackPanel>

                                <!-- Operation selector -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="PHÉP TÍNH" Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <RadioButton x:Name="OpAdd" Content="+" GroupName="Op"
                                                     IsChecked="True" Style="{StaticResource OpBtn}"/>
                                        <RadioButton x:Name="OpSub" Content="−" GroupName="Op"
                                                     Style="{StaticResource OpBtn}"/>
                                        <RadioButton x:Name="OpMul" Content="×" GroupName="Op"
                                                     Style="{StaticResource OpBtn}"/>
                                        <RadioButton x:Name="OpDiv" Content="÷" GroupName="Op"
                                                     Style="{StaticResource OpBtn}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Number B -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SỐ B" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NumberBTextBox"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="0" FontSize="22" TextAlignment="Center"
                                             Height="52"
                                             KeyDown="NumberTextBox_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- Calculate Button -->
                            <Button Grid.Row="2" x:Name="CalculateBtn"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="CalculateBtn_Click"
                                    Content="TÍNH TOÁN"
                                    FontSize="13" FontWeight="Bold"
                                    Padding="36,12"
                                    HorizontalAlignment="Center"
                                    IsEnabled="False">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00C853" Offset="0"/>
                                        <GradientStop Color="#10F08C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="14" Opacity="0.5" ShadowDepth="0" Color="#00C853"/>
                                </Button.Effect>
                            </Button>

                            <!-- Result Display -->
                            <Border Grid.Row="4" Style="{StaticResource ResultPanel}" ClipToBounds="True" MinHeight="140">
                                <Grid>
                                    <!-- Decorative large equals -->
                                    <TextBlock Text="=" FontSize="120" FontWeight="Bold"
                                               Foreground="#081324" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="0,0,24,-10"
                                               IsHitTestVisible="False"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0">
                                        <TextBlock x:Name="CalcFormulaText"
                                                   Text="KẾT QUẢ" Foreground="#7B89A8"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="60" Margin="16,0" HorizontalAlignment="Center">
                                            <TextBlock x:Name="CalcResultText"
                                                       Text="—"
                                                       FontSize="48" FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#4A9FFF" Offset="0"/>
                                                        <GradientStop Color="#8B7CF6" Offset="0.5"/>
                                                        <GradientStop Color="#00D4FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Viewbox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: Trò Chuyện Trực Tuyến ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource ChatIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Trò Chuyện" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border x:Name="ChatUnreadBadge" Background="#4A9FFF" CornerRadius="10"
                                Padding="6,2" Margin="7,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ChatUnreadCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="#0E1828" CornerRadius="16" Padding="24,20" Margin="0,8,0,0"
                        BorderBrush="#1C2D52" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header bar of Chat -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="TÊN CỦA BẠN:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Grid.Column="1" x:Name="ChatSenderTextBox"
                                     Style="{StaticResource DarkTextBox}"
                                     Text="Client 1" Height="38" Margin="0" Padding="12,6"
                                     VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChatOnlineIndicator" Width="8" Height="8" CornerRadius="4" Background="#FF6B6B" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ChatStatusText" Text="Chưa kết nối" Foreground="#7B89A8" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chat Message List -->
                        <Border Grid.Row="1" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Margin="0,0,0,14" Padding="14,10">
                            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ChatMessagesPanel">
                                    <TextBlock x:Name="ChatEmptyHint"
                                               Text="Chưa có tin nhắn nào. Hãy kết nối tới Server để bắt đầu trò chuyện!"
                                               Foreground="#4A6A8A" FontStyle="Italic"
                                               HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="13"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Chat Input Box & Send Button -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Attach File / Media Button -->
                            <Button Grid.Column="0" x:Name="ChatAttachBtn"
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="ChatAttachBtn_Click"
                                    ToolTip="Gửi ảnh, GIF, nhạc, video hoặc tệp tin vào chat"
                                    Height="44" Padding="14,0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                        <Path Data="{StaticResource AttachmentIcon}" Fill="#7B89A8" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="Đính kèm" FontSize="12" Foreground="#EEF2FF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBox Grid.Column="1" x:Name="ChatInputTextBox"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0" Height="44"
                                     KeyDown="ChatInputTextBox_KeyDown"
                                     PreviewKeyDown="ChatInputTextBox_PreviewKeyDown"
                                     VerticalContentAlignment="Center"
                                     Padding="14,0"/>

                            <Button Grid.Column="3" x:Name="SendChatBtn"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="SendChatBtn_Click"
                                    IsEnabled="False"
                                    Padding="24,11" Height="44">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4A9FFF" Offset="0"/>
                                        <GradientStop Color="#00D4FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="0" Color="#4A9FFF"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource SendIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="Gửi tin" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ── TAB 4: Truyền Tệp Tin ── -->
            <TabItem Style="{StaticResource DarkTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource FolderIcon}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Truyền Tệp Tin" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="#0E1828" CornerRadius="16" Padding="28,24" Margin="0,8,0,0"
                        BorderBrush="#1C2D52" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section 1: Upload Card -->
                        <Border Grid.Row="0" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Padding="20,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="GỬI TỆP TIN LÊN SERVER"
                                           Foreground="#7B89A8" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Choose file button -->
                                    <Button Grid.Column="0" x:Name="ChooseFileBtn"
                                            Style="{StaticResource SecondaryBtn}"
                                            Click="ChooseFileBtn_Click"
                                            Padding="18,10" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FolderIcon}" Fill="#4A9FFF" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="Chọn tệp tin..." Foreground="#EEF2FF" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Selected File label -->
                                    <Border Grid.Column="1" Background="#050A14" CornerRadius="10"
                                            BorderBrush="#1A2A48" BorderThickness="1"
                                            Padding="14,10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedFileText"
                                                   Text="Chưa chọn tệp tin nào (hỗ trợ mọi định dạng tệp...)"
                                                   Foreground="#5A7BA8" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Upload button -->
                                    <Button Grid.Column="2" x:Name="UploadFileBtn"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="UploadFileBtn_Click"
                                            IsEnabled="False"
                                            Padding="22,10">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00C853" Offset="0"/>
                                                <GradientStop Color="#10F08C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="14" Opacity="0.5" ShadowDepth="0" Color="#00C853"/>
                                        </Button.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource UploadIcon}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="Gửi lên Server" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Section 2: Files on Server -->
                        <Border Grid.Row="2" Background="#070D1C" CornerRadius="14"
                                BorderBrush="#1C2D52" BorderThickness="1" Padding="20,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="DANH SÁCH TỆP TIN TRÊN SERVER (BẤM TẢI VỀ ĐỂ LƯU)"
                                               Foreground="#7B89A8" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RefreshFilesBtn" Style="{StaticResource LinkBtn}"
                                                Click="RefreshFilesBtn_Click" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="↻  Làm mới danh sách" Foreground="#4A9FFF" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button x:Name="OpenClientDownloadsBtn" Style="{StaticResource LinkBtn}"
                                                Click="OpenClientDownloadsBtn_Click" VerticalAlignment="Center">
                                            <TextBlock Text="Mở thư mục tải về" Foreground="#7B89A8" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- File items list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ClientFileListPanel">
                                        <TextBlock x:Name="ClientFilesEmptyHint"
                                                   Text="Chưa có tệp tin nào. Kết nối tới Server và bấm 'Làm mới danh sách'!"
                                                   Foreground="#4A6A8A" FontStyle="Italic"
                                                   HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="13"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ════════════════════════════════
             ROW 3 · STATUS BAR
        ════════════════════════════════ -->
        <Border Grid.Row="3" Padding="28,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#060912" Offset="0"/>
                    <GradientStop Color="#080C18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1C2D52" Offset="0"/>
                    <GradientStop Color="#111827" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
            <Grid MaxWidth="1260" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4A9FFF" Offset="0"/>
                                <GradientStop Color="#8B7CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="StatusBarText"
                               Foreground="#3A5580" FontSize="11"
                               Text=".NET Remoting Client  ·  .NET Framework 4.7.2  ·  TCP Channel"/>
                </StackPanel>
                <TextBlock x:Name="ClientClockText" HorizontalAlignment="Right"
                           Foreground="#3A5580" FontSize="11" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas"/>
